# PostHog product analytics. Everything is optional: with no key, analytics is a silent no-op.
# Browser (read by Vite at BUILD time, so set them in Render before the build runs)
VITE_POSTHOG_KEY=your_posthog_project_token
VITE_POSTHOG_HOST=https://eu.i.posthog.com
# off = no session replay even if it is enabled in the PostHog project
VITE_POSTHOG_REPLAY=on

# Server (lifecycle events + logs); same project token, same host
POSTHOG_PROJECT_TOKEN=your_posthog_project_token
POSTHOG_HOST=https://eu.i.posthog.com
# POSTHOG_DISABLED=1  # kill switch for server events
